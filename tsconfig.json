{
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "checkJs": false, // Disable type-checking for JS files
    "skipLibCheck": true,
    "strict": true, // Keep strict mode for TS files
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "baseUrl": "src",
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./*"] // Map @/* to src/*
    },
    "target": "ES2023",
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "src/lib/mongodb.ts",
    "src/lib/dbConnect.ts",
    "src/app/category/page.tsx",
    "pages/api/scrape.js",
    "models/BusinessListing.js",
    "pages/api/businesses/[pincode]/route.js"
  ],
  "exclude": ["node_modules"]
}